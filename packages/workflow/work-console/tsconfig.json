{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "lib/types",
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/dsh-work-control": ["src/internal/control/index.ts"],
      "@deepseek-ai/dsh-work-control/*": ["src/internal/control/*"],
      "@deepseek-ai/dsh-work-execution": ["src/internal/execution/index.ts"],
      "@deepseek-ai/dsh-work-execution/*": ["src/internal/execution/*"],
