  "include": ["src"],
  "references": [
    { "path": "../../../vendor/cosmokit" },
    { "path": "../../../vendor/cordis" },
    { "path": "../../identity/anonymous-user-id" },
    { "path": "../../typert/protocol" },
    { "path": "../../runtime-diagnostics/invariants" }
