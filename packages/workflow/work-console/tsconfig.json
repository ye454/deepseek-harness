      "@deepseek-ai/dsh-work-environment": ["src/internal/environment/index.ts"],
      "@deepseek-ai/dsh-work-environment/*": ["src/internal/environment/*"],
      "@deepseek-ai/dsh-work-orchestrator": ["src/internal/orchestrator/index.ts"],
      "@deepseek-ai/dsh-work-orchestrator/*": ["src/internal/orchestrator/*"],
      "@deepseek-ai/dsh-work-validation": ["src/internal/validation/index.ts"],
      "@deepseek-ai/dsh-work-validation/*": ["src/internal/validation/*"],
      "@deepseek-ai/dsh-work-execution-coordinator": ["src/internal/execution-coordinator/index.ts"],
