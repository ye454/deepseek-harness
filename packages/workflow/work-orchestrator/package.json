{
  "name": "@deepseek-ai/dsh-work-orchestrator",
  "description": "Safe task-to-runner orchestration and isolated P0 fan-out for continuous work",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./continuation": { "types": "./lib/types/continuation.d.ts", "default": "./lib/continuation.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/continuation.js", "lib/types/**/*.d.ts", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-work-control": "workspace:^",
    "@deepseek-ai/dsh-work-environment": "workspace:^",
    "@deepseek-ai/dsh-work-execution": "workspace:^",
    "@deepseek-ai/dsh-work-node": "workspace:^",
    "@deepseek-ai/dsh-work-node-gateway": "workspace:^",
    "@deepseek-ai/dsh-work-runner-subagent": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-work-control": "workspace:^",
    "@deepseek-ai/dsh-work-environment": "workspace:^",
    "@deepseek-ai/dsh-work-execution": "workspace:^",
    "@deepseek-ai/dsh-work-node": "workspace:^",
    "@deepseek-ai/dsh-work-node-gateway": "workspace:^",
    "@deepseek-ai/dsh-work-runner-subagent": "workspace:^"
  }
}
