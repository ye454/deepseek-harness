      "@deepseek-ai/dsh-work-node-runner-codex": ["src/faces/runner-codex/index.ts"],
      "@deepseek-ai/dsh-work-node-runner-codex/*": ["src/faces/runner-codex/*"],
      "@deepseek-ai/dsh-work-node-runner-claude-code": ["src/faces/runner-claude-code/index.ts"],
      "@deepseek-ai/dsh-work-node-runner-claude-code/*": ["src/faces/runner-claude-code/*"]
